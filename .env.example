# App
NODE_ENV=development
APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Database
DATABASE_URL=postgresql://saree:saree_dev@localhost:5432/saree_tryon?schema=public

# Redis (optional for demo; reserved for production job queue)
REDIS_URL=redis://localhost:6379

# Storage
UPLOAD_DIR=./uploads
SIGNED_URL_TTL_SECONDS=900
DEFAULT_RETENTION_HOURS=24

# AI provider: demo | external | selfhosted
TRYON_PROVIDER=demo
AI_WORKER_URL=http://localhost:8000
EXTERNAL_TRYON_URL=
EXTERNAL_TRYON_API_KEY=

# Razorpay (leave empty for explicit demo/missing-credential billing mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Rate limits
KIOSK_RATE_LIMIT_PER_MIN=30
AUTH_RATE_LIMIT_PER_MIN=20

# Never put secrets in NEXT_PUBLIC_* variables
NEXT_PUBLIC_APP_NAME=trAIl9 Saree Try-On
