# App
NODE_ENV=development
APP_URL=http://localhost:3000
# Production: set a unique secret ≥32 chars (no insecure default allowed)
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Database
DATABASE_URL=postgresql://saree:saree_dev@localhost:5432/saree_tryon?schema=public

# Redis (optional for demo; reserved for production rate limits / queues)
REDIS_URL=redis://localhost:6379

# Storage: local | s3  (S3 works with AWS, Supabase Storage S3 API, MinIO, R2)
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
SIGNED_URL_TTL_SECONDS=900
DEFAULT_RETENTION_HOURS=24
CLEANUP_BATCH_SIZE=100
# Required in production for /api/internal/cleanup cron
CLEANUP_CRON_SECRET=

# S3-compatible (when STORAGE_PROVIDER=s3) — buckets must be private
# Production India VPS: prefer ap-south-1 (Mumbai) or your India-region provider
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_CATALOGUE=trail9-catalogue
S3_BUCKET_CUSTOMER=trail9-customer
S3_FORCE_PATH_STYLE=true
# DOMAIN=tryon.example.com   # used by docker-compose.prod.yml + Caddyfile

# AI provider: demo | external | selfhosted
# demo = labelled sample composites (NOT commercial AI)
TRYON_PROVIDER=demo
AI_WORKER_URL=http://localhost:8000
EXTERNAL_TRYON_URL=
EXTERNAL_TRYON_API_KEY=
EXTERNAL_TRYON_TIMEOUT_MS=20000
EXTERNAL_TRYON_MAX_RETRIES=2

# Razorpay — leave empty for explicit missing_credentials mode
# Never set RAZORPAY_MODE=live without credentials and explicit go-live approval
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
BILLING_GRACE_DAYS=3

# Rate limits
KIOSK_RATE_LIMIT_PER_MIN=30
AUTH_RATE_LIMIT_PER_MIN=20

# Never put secrets in NEXT_PUBLIC_* variables
NEXT_PUBLIC_APP_NAME=Trail9 — Your Saree. Virtually.
